{
  "name": "agent-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @agent-hq/shared -w @agent-hq/hub -w @agent-hq/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hub": "npm run dev:demo -w @agent-hq/hub",
    "hub:engine": "npm run dev:engine -w @agent-hq/hub",
    "desktop": "npm run dev -w @agent-hq/desktop",
    "smoke": "npm run smoke -w @agent-hq/hub"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
