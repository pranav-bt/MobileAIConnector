{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent HQ",
  "version": "0.1.0",
  "identifier": "dev.neureal.agenthq",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Agent HQ",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
